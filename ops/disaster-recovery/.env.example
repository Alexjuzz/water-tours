# Copy to .env in this same folder and fill in. Never commit the real .env.
# Reuse the same values as the live server's .env where it makes sense (staff
# creds, Telegram, YooKassa) - restore.sh does not read those for you.

STAFF_USERNAME=staff
STAFF_PASSWORD=replace-with-a-real-password
STAFF_REMEMBER_ME_KEY=replace-with-a-random-value

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STAFF_TELEGRAM_CHAT_IDS=

YOOKASSA_SHOP_ID=not-configured-yet
YOOKASSA_SECRET_KEY=not-configured-yet
MAIL_USERNAME=not-configured-yet@example.invalid
MAIL_PASSWORD=not-configured-yet

# Where this instance will be reachable, e.g. http://localhost or https://water-tours.ru
APP_BASE_URL=http://localhost

# New MariaDB credentials for this recovery instance (not the same as Postgres above)
WORDPRESS_DB_ROOT_PASSWORD=replace-with-a-random-value
WORDPRESS_DB_PASSWORD=replace-with-a-random-value
